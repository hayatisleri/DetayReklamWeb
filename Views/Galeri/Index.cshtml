@model IEnumerable<KurumsalWebSitesi.Models.Entities.Galeri>
@{
    ViewData["Title"] = "Fotoğraf Galerisi";
}

<!-- Tıklayınca büyütme kütüphanesi (GLightbox) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/glightbox/3.3.0/css/glightbox.min.css" />

<section class="py-5 bg-light position-relative">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="text-uppercase tracking-widest text-muted small fw-bold">Tesislerimizden ve Çalışmalarımızdan Kareler</span>
            <h1 class="fw-bold display-5 mt-2 text-dark">Fotoğraf Galerisi</h1>
            <p class="text-muted">Görsellerin üzerine gelip tıklayarak detaylı olarak inceleyebilirsiniz.</p>
        </div>

        <div class="gallery-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <a href="@item.ResimAdresi" class="glightbox gallery-item rounded-4 shadow-sm overflow-hidden d-block position-relative" data-gallery="kurumsal-galeri" data-title="@item.Baslik">
                        <img src="@item.ResimAdresi" alt="@item.Baslik" class="w-100 h-100 object-fit-cover" loading="lazy" />
                        <div class="gallery-overlay d-flex align-items-end p-4">
                            <div class="text-white">
                                <span class="badge bg-white text-dark rounded-pill px-3 py-1 mb-2 fw-medium"><i class="fa-solid fa-magnifying-glass-plus me-1"></i> Büyüt</span>
                                <h5 class="fw-bold mb-0 text-white">@item.Baslik</h5>
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Galeride henüz görsel bulunmamaktadır.</p>
                </div>
            }
        </div>
    </div>
</section>

<style>
    /* Sigorta Derneği Tarzı Modern Dinamik Izgara */
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        grid-auto-rows: 240px;
        grid-auto-flow: dense;
        gap: 20px;
    }
    .gallery-item {
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        cursor: pointer;
    }
    @@media (min-width: 992px) {
        .gallery-item:nth-child(5n + 1) {
            grid-column: span 2;
            grid-row: span 2;
        }
    }
    .gallery-item img {
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .gallery-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.75) 100%);
        opacity: 0;
        transition: opacity 0.35s ease;
    }
    .gallery-item:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 32px rgba(0,0,0,0.15) !important;
    }
    .gallery-item:hover img {
        transform: scale(1.08);
    }
    .gallery-item:hover .gallery-overlay {
        opacity: 1;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/glightbox/3.3.0/js/glightbox.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const lightbox = GLightbox({
            selector: '.glightbox',
            touchNavigation: true,
            loop: true,
            zoomable: true
        });
    });
</script>