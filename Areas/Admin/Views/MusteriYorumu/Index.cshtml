@model List<KurumsalWebSitesi.Models.Entities.MusteriYorumu>
@{
    ViewData["Title"] = "Müşteri Görüşleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-dark fw-bold">Müşteri Görüşleri</h2>
    <a href="/Admin/MusteriYorumu/Ekle" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Yeni Görüş Ekle
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sıra</th>
                    <th>Müşteri / Şirket</th>
                    <th>Unvan</th>
                    <th>Yorum</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Sira</td>
                            <td class="fw-bold">@item.AdSoyad</td>
                            <td>@(item.Unvan ?? "-")</td>
                            <td class="text-truncate" style="max-width: 250px;">@item.Yorum</td>
                            <td>
                                @if (item.AktifMi)
                                {
                                    <span class="badge bg-success">Yayında</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Admin/MusteriYorumu/Duzenle/@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form action="/Admin/MusteriYorumu/Sil/@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu yorumu silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Henüz kayıtlı müşteri görüşü bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>