@model KurumsalWebSitesi.Models.Entities.Menu
@{
    ViewData["Title"] = "Menü Düzenle";
    var anaMenuler = ViewBag.AnaMenuler as List<KurumsalWebSitesi.Models.Entities.Menu>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-dark fw-bold">Menü Düzenle</h2>
    <a href="/Admin/Menu/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Geri Dön</a>
</div>

<form action="/Admin/Menu/Duzenle" method="post" class="card p-4 shadow-sm border-0">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="fw-bold">Menü Başlığı <span class="text-danger">*</span></label>
            <input name="Baslik" class="form-control" value="@Model.Baslik" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="fw-bold">URL / Bağlantı <span class="text-danger">*</span></label>
            <input name="Url" class="form-control" value="@Model.Url" required />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="fw-bold">Üst Menü</label>
            <select name="UstMenuId" class="form-select">
                <option value="">-- Bu Bir Ana Menüdür --</option>
                @if (anaMenuler != null)
                {
                    foreach (var item in anaMenuler)
                    {
                        if (Model.UstMenuId == item.Id)
                        {
                            <option value="@item.Id" selected>@item.Baslik</option>
                        }
                        else
                        {
                            <option value="@item.Id">@item.Baslik</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label class="fw-bold">Sıra</label>
            <input type="number" name="Sira" class="form-control" value="@Model.Sira" />
        </div>
        <div class="col-md-3 mb-3 d-flex align-items-end pb-2">
            <div class="form-check form-switch fs-5">
                <input class="form-check-input" type="checkbox" name="AktifMi" value="true" @(Model.AktifMi ? "checked" : "") id="AktifMi">
                <label class="form-check-label fw-bold ms-2" for="AktifMi">Aktif</label>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary px-4 py-2"><i class="fa-solid fa-floppy-disk me-1"></i> Değişiklikleri Kaydet</button>
    </div>
</form>