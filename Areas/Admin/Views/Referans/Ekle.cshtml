@model KurumsalWebSitesi.Models.Entities.Referans
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Yeni Referans Ekle";
}

<div class="container-fluid p-4">
    <div class="card shadow-sm border-0" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Yeni Referans / Logo Ekle</h5>
            <a href="/Admin/Referans/Index" class="btn btn-outline-light btn-sm">Geri Dön</a>
        </div>
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="Referans" asp-action="Ekle" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Firma Adı</label>
                    <input type="text" name="FirmaAdi" class="form-control" placeholder="Örn: Tiny House, Torino, Fulya Diş" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Sıra No</label>
                    <input type="number" name="Sira" class="form-control" value="0" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Logo Dosyası</label>
                    <input type="file" name="logoDosyasi" class="form-control" accept="image/*" required />
                    <small class="text-muted">Masaüstüne kaydettiğin logoyu seç.</small>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">Logoyu Kaydet</button>
                    <a href="/Admin/Referans/Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>