@model List<KurumsalWebSitesi.Models.Entities.Referans>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Referanslar & Marka Logoları";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Referanslar &amp; Marka Logoları</h3>
            <p class="text-muted small mb-0">Ana sayfadaki referans kutularında sergilenecek müşteri ve iş ortaklarının logolarını yönetin.</p>
        </div>
        <a href="/Admin/Referans/Ekle" class="btn btn-primary px-3 py-2 fw-bold">
            <i class="fa-solid fa-plus me-1"></i> Yeni Referans / Logo Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Logo</th>
                            <th>Firma Adı</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th class="text-end pe-4" style="width: 120px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="border rounded p-1 bg-white d-flex align-items-center justify-content-center" style="width: 80px; height: 50px;">
                                            @if (!string.IsNullOrEmpty(item.LogoAdresi))
                                            {
                                                <img src="@item.LogoAdresi" style="max-height: 40px; max-width: 70px; object-fit: contain;" alt="@item.FirmaAdi" />
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Logo Yok</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="fw-bold text-dark">@item.FirmaAdi</td>
                                    <td>@item.Sira</td>
                                    <td>
                                        <span class="badge @(item.AktifMi ? "bg-success" : "bg-secondary")">
                                            @(item.AktifMi ? "Aktif" : "Pasif")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-area="Admin" asp-controller="Referans" asp-action="Sil" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu referansı silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="fa-solid fa-trash"></i> Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    Henüz referans logo eklenmedi. Yeni Referans / Logo Ekle butonuna basarak ilk logoyu ekleyebilirsiniz.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>