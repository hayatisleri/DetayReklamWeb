@model KurumsalWebSitesi.Models.Entities.Slayt

@{
    ViewData["Title"] = "Yeni Slayt Ekle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-gray-800">Yeni Slayt Ekle</h2>
    <a href="/Admin/Slayt/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Geri Dön</a>
</div>

<form action="/Admin/Slayt/Ekle" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <!-- Varsa Model Hatalarını Kırmızı Kutu İçinde Göster -->
    <div asp-validation-summary="All" class="alert alert-danger mb-4" style="display: @(ViewData.ModelState.IsValid ? "none" : "block");"></div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body">
                    <div class="mb-3">
                        <label for="Baslik" class="form-label fw-bold">Ana Başlık</label>
                        <input type="text" class="form-control" id="Baslik" name="Baslik" value="@Model?.Baslik" placeholder="Örn: Işıklı Kutu Harf Tabela">
                        <small class="text-muted">Slayt üzerinde görünecek büyük metin.</small>
                    </div>

                    <div class="mb-3">
                        <label for="AltBaslik" class="form-label fw-bold">Alt Başlık</label>
                        <input type="text" class="form-control" id="AltBaslik" name="AltBaslik" value="@Model?.AltBaslik" placeholder="Örn: Şehrinize Işık Katan Çözümler">
                        <small class="text-muted">Ana başlığın altında yer alacak tamamlayıcı metin.</small>
                    </div>

                    <div class="mb-3">
                        <label for="LinkAdresi" class="form-label fw-bold">Yönlendirme Linki (URL)</label>
                        <input type="text" class="form-control" id="LinkAdresi" name="LinkAdresi" value="@Model?.LinkAdresi" placeholder="/Iletisim">
                        <small class="text-muted">Slayta tıklanınca gidilecek adres.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body">
                    <div class="mb-4">
                        <label for="resimDosyasi" class="form-label fw-bold">Slayt Görseli <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="resimDosyasi" name="resimDosyasi" accept="image/*" required>
                        <small class="text-muted">Tabela fotoğrafınızı seçin.</small>
                    </div>

                    <div class="mb-3">
                        <label for="Sira" class="form-label fw-bold">Gösterim Sırası</label>
                        <input type="number" class="form-control" id="Sira" name="Sira" value="@(Model?.Sira ?? 1)">
                    </div>

                    <div class="mb-4 form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="AktifMi" name="AktifMi" value="true" checked>
                        <!-- Checkbox unchecked olduğunda modelin bozulmaması için arka plan değeri -->
                        <input type="hidden" name="AktifMi" value="false" />
                        <label class="form-check-label fw-bold" for="AktifMi">Slayt Aktif Olsun Mu?</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2"><i class="fa-solid fa-floppy-disk me-1"></i> Kaydet</button>
                </div>
            </div>
        </div>
    </div>
</form>