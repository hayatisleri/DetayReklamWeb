@model KurumsalWebSitesi.Models.Entities.OneCikanKutu
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Yeni Kutu Ekle";
}
<div class="container py-4">
    <div class="card shadow-sm p-4">
        <h3 class="mb-4">Yeni Öne Çıkan Kutu Ekle</h3>
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label font-weight-bold">Başlık (Örn: Totem Tabela)</label>
                <input asp-for="Baslik" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">İkon Bootstrap Class (Örn: bi bi-star-fill, bi bi-printer-fill)</label>
                <input asp-for="Ikon" class="form-control" value="bi bi-star-fill" />
            </div>
            <div class="mb-3">
                <label class="form-label">Link (Örn: #cozumler veya sayfa linki)</label>
                <input asp-for="Link" class="form-control" value="#cozumler" />
            </div>
            <div class="mb-3">
                <label class="form-label">Sıra</label>
                <input asp-for="Sira" class="form-control" type="number" value="1" />
            </div>
            <div class="form-check mb-4">
                <input asp-for="AktifMi" class="form-check-input" type="checkbox" checked />
                <label class="form-check-label">Aktif mi?</label>
            </div>
            <button type="submit" class="btn btn-success px-4">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Geri Dön</a>
        </form>
    </div>
</div>