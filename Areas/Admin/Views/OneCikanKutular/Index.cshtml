@model List<KurumsalWebSitesi.Models.Entities.OneCikanKutu>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Öne Çıkan Kutular";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Öne Çıkan Kutu Yönetimi</h2>
        <a asp-action="Create" class="btn btn-primary">+ Yeni Kutu Ekle</a>
    </div>

    <table class="table table-bordered table-striped align-middle bg-white">
        <thead class="table-dark">
            <tr>
                <th>Sıra</th>
                <th>Başlık</th>
                <th>İkon</th>
                <th>Link</th>
                <th>Durum</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Sira</td>
                        <td><strong>@item.Baslik</strong></td>
                        <td><i class="@item.Ikon fs-4"></i> (@item.Ikon)</td>
                        <td>@item.Link</td>
                        <td>
                            <span class="badge @(item.AktifMi ? "bg-success" : "bg-danger")">
                                @(item.AktifMi ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-3">Henüz kutu eklenmedi. Eklediğinizde ana sayfada yana kaydırmalı olarak görünecektir.</td>
                </tr>
            }
        </tbody>
    </table>
</div>