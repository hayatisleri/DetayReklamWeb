@model KurumsalWebSitesi.Models.Entities.Galeri

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">Görsel Düzenle</h2>
    <a href="/Admin/Galeri/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Geri Dön</a>
</div>
<form action="/Admin/Galeri/Duzenle" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-0">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="ResimAdresi" value="@Model.ResimAdresi" />

    <div class="mb-3 text-center">
        <img src="@Model.ResimAdresi" style="max-height:150px;" class="rounded border p-1" />
    </div>

    <div class="mb-3"><label class="fw-bold">Başlık</label><input name="Baslik" class="form-control" value="@Model.Baslik" required /></div>
    <div class="mb-3"><label class="fw-bold">Sıra</label><input type="number" name="Sira" class="form-control" value="@Model.Sira" /></div>
    <div class="mb-3"><label class="fw-bold">Görseli Değiştir</label><input type="file" name="resimDosyasi" class="form-control" accept="image/*" /></div>
    <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
</form>