@model KurumsalWebSitesi.Models.Entities.Galeri


<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">Yeni Görsel Ekle</h2>
    <a href="/Admin/Galeri/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Geri Dön</a>
</div>
<form action="/Admin/Galeri/Ekle" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-0">
    @Html.AntiForgeryToken()
    <div class="mb-3"><label class="fw-bold">Başlık</label><input name="Baslik" class="form-control" required /></div>
    <div class="mb-3"><label class="fw-bold">Sıra</label><input type="number" name="Sira" class="form-control" value="0" /></div>
    <div class="mb-3"><label class="fw-bold">Görsel</label><input type="file" name="resimDosyasi" class="form-control" accept="image/*" required /></div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>