@model KurumsalWebSitesi.Models.Entities.Proje
@{
    ViewData["Title"] = "Proje Düzenle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-dark fw-bold">Proje Düzenle</h2>
    <a href="/Admin/Proje/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Geri Dön</a>
</div>

<form id="projeForm" action="/Admin/Proje/Duzenle/@Model.Id" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-0">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="KapakResmi" value="@Model.KapakResmi" />

    <div class="mb-3">
        <label class="fw-bold">Başlık <span class="text-danger">*</span></label>
        <input name="Baslik" class="form-control" value="@Model.Baslik" required />
    </div>

    <div class="mb-3">
        <label class="fw-bold">İçerik</label>
        <textarea id="Icerik" name="Icerik" class="form-control">@Model.Icerik</textarea>
    </div>

    <div class="mb-3">
        <label class="fw-bold">Görsel (Değiştirmek için yeni dosya seçin)</label>
        <input type="file" name="kapakResmi" class="form-control" />
        @if (!string.IsNullOrEmpty(Model.KapakResmi))
        {
            <div class="mt-2">
                <p class="small text-muted mb-1">Mevcut Görsel:</p>
                <img src="@Model.KapakResmi" style="width:120px; height:80px; object-fit:cover;" class="rounded border" />
            </div>
        }
    </div>

    <div class="mb-3 form-check form-switch">
        <input class="form-check-input" type="checkbox" name="AktifMi" value="true" @(Model.AktifMi ? "checked" : "") id="AktifMi">
        <label class="form-check-label fw-bold" for="AktifMi">Aktif</label>
    </div>

    <button type="submit" class="btn btn-primary px-4">Güncelle</button>
</form>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        let editorInstance;
        ClassicEditor
            .create(document.querySelector('#Icerik'))
            .then(editor => {
                editorInstance = editor;
            })
            .catch(error => {
                console.error(error);
            });

        document.getElementById('projeForm').addEventListener('submit', function () {
            if (editorInstance) {
                document.querySelector('#Icerik').value = editorInstance.getData();
            }
        });
    </script>
}