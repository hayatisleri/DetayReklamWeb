@model KurumsalWebSitesi.Models.Entities.Haber

@{
    ViewData["Title"] = "Yeni Haber Ekle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-gray-800">Yeni Haber Ekle</h2>
    <a href="/Admin/Haber/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Geri Dön</a>
</div>

<form action="/Admin/Haber/Ekle" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body">
                    <div class="mb-3">
                        <label for="Baslik" class="form-label fw-bold">Haber Başlığı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Baslik" name="Baslik" required>
                    </div>

                    <div class="mb-3">
                        <label for="Ozet" class="form-label fw-bold">Kısa Özet</label>
                        <textarea class="form-control" id="Ozet" name="Ozet" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="Icerik" class="form-label fw-bold">Haber Detayı</label>
                        <textarea id="Icerik" name="Icerik" class="form-control"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body">
                    <div class="mb-3">
                        <label for="SeoUrl" class="form-label fw-bold">SEO URL (Slug) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control bg-light" id="SeoUrl" name="SeoUrl" required>
                        <small class="text-muted">Başlıktan otomatik doldurulur.</small>
                    </div>

                    <div class="mb-4">
                        <label for="resimDosyasi" class="form-label fw-bold">Kapak Görseli</label>
                        <input type="file" class="form-control" id="resimDosyasi" name="resimDosyasi" accept="image/jpeg, image/png, image/webp">
                    </div>

                    <div class="mb-4 form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="AktifMi" name="AktifMi" value="true" checked>
                        <label class="form-check-label fw-bold" for="AktifMi">Haber Aktif Olsun Mu?</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2"><i class="fa-solid fa-floppy-disk me-1"></i> Kaydet</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <style>
        .ck-editor__editable_inline {
            min-height: 300px;
        }
    </style>
    <script>
        ClassicEditor.create(document.querySelector('#Icerik')).catch(error => { console.error(error); });

        document.getElementById('Baslik').addEventListener('keyup', function () {
            var title = this.value;
            var seourl = title.toLowerCase()
                .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's')
                .replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ç/g, 'c')
                .replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
            document.getElementById('SeoUrl').value = seourl;
        });
    </script>
}