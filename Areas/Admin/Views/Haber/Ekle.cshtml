@model KurumsalWebSitesi.Models.Entities.Haber

@{
    ViewData["Title"] = "Yeni Haber Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0">Yeni Haber Ekle</h3>
        <a href="/Admin/Haber" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Geri Dön</a>
    </div>

    <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Ekle" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card p-4 shadow-sm border-0">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Haber Başlığı <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Baslik" id="haberBaslik" class="form-control" required placeholder="Haber başlığını giriniz..." />
                        <span asp-validation-for="Baslik" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Kısa Özet</label>
                        <textarea asp-for="Ozet" class="form-control" rows="3" placeholder="Haberin kısa bir özetini yazınız..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Haber Detayı</label>
                        <textarea asp-for="Icerik" id="editor" class="form-control" rows="8"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card p-4 shadow-sm border-0">
                    <div class="mb-3">
                        <label class="form-label fw-bold">SEO URL <span class="text-danger">*</span></label>
                        <input type="text" asp-for="SeoUrl" id="haberSeoUrl" class="form-control" required placeholder="ornek-haber-linki" />
                        <small class="text-muted">Başlıktan otomatik doldurulur.</small>
                        <span asp-validation-for="SeoUrl" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Kapak Görseli</label>
                        <input type="file" name="resimDosyasi" class="form-control" accept="image/*" />
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="AktifMi" id="aktifSwitch" checked>
                        <label class="form-check-label fw-bold" for="aktifSwitch">Haber Aktif Olsun Mu?</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                        <i class="bi bi-save me-1"></i> Kaydet
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('haberBaslik').addEventListener('input', function () {
            let str = this.value;
            let slug = str.toLowerCase()
                .trim()
                .replace(/ğ/g, 'g')
                .replace(/ü/g, 'u')
                .replace(/ş/g, 's')
                .replace(/ı/g, 'i')
                .replace(/ö/g, 'o')
                .replace(/ç/g, 'c')
                .replace(/[^a-z0-9 -]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
            document.getElementById('haberSeoUrl').value = slug;
        });
    </script>
}