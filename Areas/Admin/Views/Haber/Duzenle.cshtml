@model KurumsalWebSitesi.Models.Entities.Haber

@{
    ViewData["Title"] = "Haber Düzenle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-gray-800">Haber Düzenle</h2>
    <a href="/Admin/Haber/Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Geri Dön</a>
</div>

<form action="/Admin/Haber/Duzenle" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="OlusturulmaTarihi" value="@Model.OlusturulmaTarihi.ToString("yyyy-MM-ddTHH:mm:ss")" />
    <input type="hidden" name="ResimAdresi" value="@Model.ResimAdresi" />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body">
                    <div class="mb-3">
                        <label for="Baslik" class="form-label fw-bold">Haber Başlığı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Baslik" name="Baslik" required value="@Model.Baslik">
                    </div>

                    <div class="mb-3">
                        <label for="Ozet" class="form-label fw-bold">Kısa Özet</label>
                        <textarea class="form-control" id="Ozet" name="Ozet" rows="2">@Model.Ozet</textarea>
                    </div>

                    <div class="mb-3">
                        <label for="Icerik" class="form-label fw-bold">Haber Detayı</label>
                        <textarea id="Icerik" name="Icerik" class="form-control">@Html.Raw(Model.Icerik)</textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body text-center mb-3">
                    <label class="form-label fw-bold d-block text-start">Mevcut Görsel</label>
                    @if (!string.IsNullOrEmpty(Model.ResimAdresi))
                    {
                        <img src="@Model.ResimAdresi" class="img-fluid img-thumbnail rounded mb-2" alt="Mevcut Görsel" style="max-height: 200px;">
                    }
                    else
                    {
                        <div class="bg-light p-4 rounded text-muted border mb-2">
                            <i class="fa-regular fa-image fs-1 mb-2"></i><br />Görsel Yok
                        </div>
                    }
                </div>

                <div class="card-body border-top pt-3">
                    <div class="mb-3">
                        <label for="SeoUrl" class="form-label fw-bold">SEO URL (Slug) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="SeoUrl" name="SeoUrl" required value="@Model.SeoUrl">
                    </div>

                    <div class="mb-4">
                        <label for="resimDosyasi" class="form-label fw-bold">Görseli Değiştir</label>
                        <input type="file" class="form-control" id="resimDosyasi" name="resimDosyasi" accept="image/jpeg, image/png, image/webp">
                    </div>

                    <div class="mb-4 form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="AktifMi" name="AktifMi" value="true" @(Model.AktifMi ? "checked" : "")>
                        <label class="form-check-label fw-bold" for="AktifMi">Haber Aktif Olsun Mu?</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2"><i class="fa-solid fa-floppy-disk me-1"></i> Değişiklikleri Kaydet</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <style>
        .ck-editor__editable_inline {
            min-height: 300px;
        }
    </style>
    <script>
        ClassicEditor.create(document.querySelector('#Icerik')).catch(error => { console.error(error); });
    </script>
}